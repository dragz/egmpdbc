	SG_ Seat_Level_Driver    : 36|4@1+ (1,0) [0|15] "" Vector__XXX

CM_ BO_ 1186 "Seat_Heat_Vent_Control (0x4A2): D5 (byte 4). High nibble = driver, low nibble = passenger. F = idle/no-change. EV6 values: 5=Vent_High, 4=Vent_Med, 3=Vent_Low, 2=Clear_All.";
CM_ SG_ 1186 Seat_Level_Driver "byte 4 high nibble (mask 0xF0): 2=Clear, 3=Vent_Low, 4=Vent_Med, 5=Vent_High, F=Idle";
CM_ SG_ 1186 Seat_Level_Passenger "byte 4 low nibble (mask 0x0F): same codes as driver, F=Idle";

VAL_ 1186 Seat_Level_Driver 2 "Clear" 3 "Vent_Low" 4 "Vent_Med" 5 "Vent_High" 15 "Idle" ;
VAL_ 1186 Seat_Level_Passenger 2 "Clear" 3 "Vent_Low" 4 "Vent_Med" 5 "Vent_High" 15 "Idle" ;

