CM_ SG_ 1266 Brightness_Raw "byte 7 (D8): brightness level, 0x19-0xFA";

BO_ 1624 Active_Sound_Design: 8 Vector__XXX
	SG_ ASD_Byte0 : 0|8@1+ (1,0) [0|255] "" Vector__XXX
	SG_ ASD_Byte1 : 8|8@1+ (1,0) [0|255] "" Vector__XXX
	SG_ ASD_Byte2 : 16|8@1+ (1,0) [0|255] "" Vector__XXX

CM_ BO_ 1624 "Active_Sound_Design (0x658). Largest Change: D2 FD->FF. Moderate: D1 FD->FF & D2 FD->FF. Smallest: D2 FC->FF. Off: D1 7F->FF & D2 FC->FF.";
CM_ SG_ 1624 ASD_Byte0 "byte 0 (D1): 0x7F=Off, 0xFD=Moderate_Change, 0xFB=Custom_Style, 0x87=Stylish, 0x8B=Dynamic, 0x8F=Cyber";
CM_ SG_ 1624 ASD_Byte1 "byte 1 (D2): 0xFD=Largest (or Moderate when paired with D1 FD), 0xFC=Smallest (or Off when paired with D1 7F), 0x7F=pairs with even Master Vol steps. Custom style: 0x87=Stylish, 0x8B=Dynamic, 0x8F=Cyber";
CM_ SG_ 1624 ASD_Byte2 "byte 2 (D3): Response: 0x9F=Slow, 0xAF=Normal, 0xBF=Fast. Master Vol: byte = 0xF0 + floor(vol/2); even-numbered volume steps also set D2=0x7F";

VAL_ 1624 ASD_Byte0 127 "Off" 135 "Stylish" 139 "Dynamic" 143 "Cyber" 251 "Custom_Style" 253 "Moderate_Change" ;
VAL_ 1624 ASD_Byte1 127 "Volume_Even_Step" 135 "Custom_Stylish" 139 "Custom_Dynamic" 143 "Custom_Cyber" 252 "Smallest_Change" 253 "Largest_Change" ;
VAL_ 1624 ASD_Byte2 159 "Response_Slow" 175 "Response_Normal" 191 "Response_Fast" 240 "Vol_0_1" 241 "Vol_2_3" 242 "Vol_4_5" 243 "Vol_6_7" 244 "Vol_8_9" 245 "Vol_10_11" 246 "Vol_12_13" 247 "Vol_14_15" 248 "Vol_16_17" 249 "Vol_18_19" 250 "Vol_20" ;

BO_ 719 Cabin_Temp_Control: 8 Vector__XXX
	SG_ Step_Cycle        : 0|8@1+ (1,0) [0|255] "" Vector__XXX
	SG_ Driver_Temp_Cmd   : 8|8@1+ (1,0) [0|255] "" Vector__XXX
	SG_ Passenger_Temp_Cmd : 16|8@1+ (1,0) [0|255] "" Vector__XXX

CM_ BO_ 719 "Cabin_Temp_Control (0x2CF): head-unit climate temp up/down (EV6). D1 cycles 0x0F/0x1F/0x2F per step; D2 (byte1) 0x01=Driver Up, 0x80=Driver Down; D3 (byte2) 0x01=Passenger Up, 0x80=Passenger Down. Source notes this is UI-only for driver temp.";
CM_ SG_ 719 Step_Cycle "byte 0 (D1): cycles 0x0F/0x1F/0x2F for each step (needed to advance another step)";
CM_ SG_ 719 Driver_Temp_Cmd "byte 1 (D2): 0x01=Driver Up, 0x80=Driver Down";
CM_ SG_ 719 Passenger_Temp_Cmd "byte 2 (D3): 0x01=Passenger Up, 0x80=Passenger Down";

VAL_ 719 Driver_Temp_Cmd 1 "Driver_Up" 128 "Driver_Down" ;
VAL_ 719 Passenger_Temp_Cmd 1 "Passenger_Up" 128 "Passenger_Down" ;

BA_ "VFrameFormat" BO_ 2323819011 1;
