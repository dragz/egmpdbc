CM_ BO_ 1184 "Climate_Sync_Control (0x4A0): byte 3 (D4). 0x0B->0x0F = Sync On, 0x07->0x0F = Sync Off. 0x0F = applied/idle.";
CM_ SG_ 1184 Sync_Request "byte 3 (D4): 0x07=Sync_Off, 0x0B=Sync_On, 0x0F=Applied";

VAL_ 1184 Sync_Request 7 "Sync_Off" 11 "Sync_On" 15 "Applied" ;

BO_ 1186 Seat_Heat_Vent_Control: 8 Vector__XXX
