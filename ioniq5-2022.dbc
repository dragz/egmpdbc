CM_ BO_ 1183 "Climate_Temp_Control (0x49F): byte 0 (D1). 0x70->0xF0 = Driver Temp Up, 0xB0->0xF0 = Driver Down, 0xD0->0xF0 = Passenger Up, 0xE0->0xF0 = Passenger Down. 0xF0 = released/idle. Also contains AC toggle and auto toggle (unspecified bits). Head-unit-generated.";
CM_ SG_ 1183 Temp_Control "byte 0 (D1): high nibble encodes direction, F0=idle";

VAL_ 1183 Temp_Control 112 "Driver_Temp_Up" 176 "Driver_Temp_Down" 208 "Passenger_Temp_Up" 224 "Passenger_Temp_Down" 240 "Idle" ;

