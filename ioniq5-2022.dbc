CM_ BO_ 1053 "Climate_Driver_Only_Control (0x41D): byte 4 (D5) toggles 0x0D->0x0F for on, 0x0C->0x0F for off. Heat toggle also on this frame (unspecified bits). Head-unit-generated climate control.";
CM_ SG_ 1053 Driver_Only_Request "byte 4 (D5): 0x0C=Driver_Only_Off, 0x0D=Driver_Only_On, 0x0F=Applied";

VAL_ 1053 Driver_Only_Request 12 "Driver_Only_Off" 13 "Driver_Only_On" 15 "Applied" ;

